# Copy to .env.local (git-ignored). Never commit real keys.

# PayPal sandbox REST app: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Owners sign in with PayPal instead of an owner secret. Turn on "Log in with PayPal" for the app in the
# PayPal developer dashboard first: return URL <PUBLIC_BASE_URL>/api/owner/paypal/callback, and ask for
# email, payer ID and account verification status.
PAYPAL_LOGIN=false
# Owners connect their own PayPal so sales are paid straight to them (PayPal partner onboarding). The
# app above must be a "Platform" app, and this is its business account's merchant id (Account ID in the
# sandbox accounts list). Empty: sales go to the app's own account.
PAYPAL_PARTNER_MERCHANT_ID=

# AI for onboarding (reads product photos) and drafting say-so rules. OpenAI is used when its key is
# set (gpt-4.1-mini by default), DeepSeek otherwise; AI_PROVIDER=openai|deepseek forces one.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Most the server may spend on AI per day, in USD.
AI_DAILY_BUDGET_USD=0.50

# Market prices for owners (what similar items sell for elsewhere), from Channel3: https://trychannel3.com/developers
# Optional: without it the price_check tool and the catalog's market column are off.
CHANNEL3_API_KEY=

# Public URL of this app (PayPal return URLs, approval links, MCP URLs shown to users).
PUBLIC_BASE_URL=http://localhost:3000

# Signs owner sessions. Required in production; any long random string (openssl rand -hex 32).
SAYSO_SECRET=

# Demo shop (Maya Ceramics). SAYSO_DEMO=true shows an "Open the demo shop" button on the owner sign-in.
SAYSO_DEMO=true
SAYSO_DEMO_OWNER_SECRET=sk_owner_change-me
SAYSO_DEMO_AGENT_KEY=sk_agent_change-me
# Restore the demo shop's stock and rules on every boot (handy before recording).
SAYSO_RESET_DEMO=false
# The judges' tour (/tour, with SAYSO_DEMO=true). A connected saved-PayPal wallet id (wal_...) whose sandbox
# approval the tour's buyer assistant may pay with; without it the tour hands out PayPal links instead.
SAYSO_TOUR_WALLET=
# Builds the developer portal during deploys (npm run apimatic -- portal --optional): an APIMatic API key.
APIMATIC_AUTH_KEY=
# Lets a scheduled job clean up expired tour copies: POST /api/internal/sweep with "Authorization: Bearer <this>".
SAYSO_CRON_SECRET=

# Optional: push one shop's say-so requests to its owner's phone with ntfy (https://ntfy.sh). Use a
# hard-to-guess topic; pushes carry the kind of request and a link, never buyer details.
SAYSO_NTFY_TOPIC=
SAYSO_NTFY_SHOP=shop_maya

# Behind Cloudflare, believe the CF-Connecting-IP header for per-address limits. Leave off otherwise.
SAYSO_TRUST_CF_IP=false

# Postgres (Render sets this). Leave empty to keep everything in memory locally.
DATABASE_URL=

