# Copy to .env.local (git-ignored). Never commit real keys.

# PayPal sandbox REST app: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Webhook id from the same app (Webhooks section), used to verify webhook signatures.
PAYPAL_WEBHOOK_ID=

# DeepSeek (OpenAI-compatible API): https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash supports image input (catalog from photos); deepseek-v4-pro for harder reasoning.
DEEPSEEK_MODEL=deepseek-flash

# Public URL of this app (PayPal return/cancel URLs, MCP endpoint shown to judges).
PUBLIC_BASE_URL=http://localhost:3000

# Optional: AG Studio licence key (45-day hackathon trial) for the dashboard.
AG_STUDIO_LICENSE=

# Optional: Channel3 product data API (promo code PAYPAL-HACKATHON-2026).
CHANNEL3_API_KEY=

# Postgres (Render). Leave empty to use in-memory stores locally.
DATABASE_URL=

# Require a PayPal-issued JWT on the merchant-cart API (only once onboarded to PayPal's platform).
SAYSO_REQUIRE_PAYPAL_JWT=false
